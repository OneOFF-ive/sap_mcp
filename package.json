{
  "name": "sap-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local HTTP MCP server for SAP ABAP development",
  "bin": {
    "sap-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/cli.js",
    "dev": "node --import tsx src/cli.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "2.1.1",
    "abap-adt-api": "8.5.0",
    "axios": "1.20.0",
    "commander": "15.0.0",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
